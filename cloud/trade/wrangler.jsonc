{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trade-advisor",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trade-advisor-db",
      // Replace with Publiusly production D1 database_id when deploying at home
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ID": "trade",
    "SESSION_TTL_SECONDS": "604800"
  }
  // Secrets (set via wrangler secret / .dev.vars): SESSION_SECRET, ALPACA_API_KEY, ALPACA_SECRET_KEY, ALPHA_VANTAGE_API_KEY
}
